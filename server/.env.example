# ============================================
# 英文联想编辑器 - 后端环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================

# 服务端口
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=english_association

# JWT 配置
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS 允许的前端域名（逗号分隔）
CORS_ORIGINS=http://localhost:5173

# Redis 配置（用于验证码存储、登录尝试记录）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 加密密钥（用于手机号加密）
ENCRYPTION_KEY=your_32_char_encryption_key_here

# 测试号配置（开发/测试环境使用，生产环境请留空）
# 配置后该手机号可跳过短信发送，使用固定验证码直接登录
TEST_PHONE=
TEST_CODE=
