# ============================================
# 英文联想编辑器 - 后端环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================

# 服务端口
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=english_association

# JWT 配置
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS 允许的前端域名（逗号分隔）
CORS_ORIGINS=http://localhost:5173

# 加密密钥（用于手机号加密）
ENCRYPTION_KEY=your_32_char_encryption_key_here
